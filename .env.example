# Copy this file to .env.local and fill in values,
# OR add these variables directly in Vercel Project Settings → Environment Variables

# =============================================================
# DATABASE (Vercel Postgres / Neon / Supabase)
# =============================================================
POSTGRES_URL="postgresql://default:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Direct URL for migrations (Optional for Neon/Supabase)
# DIRECT_URL="postgresql://default:password@ep-sample.us-east-1.aws.neon.tech/neondb?sslmode=require"

# =============================================================
# INTERNAL API SECURITY
# =============================================================
# Generate a strong random secret: openssl rand -hex 32
# Set this in Vercel Environment Variables (Production + Preview).
# When set, the GET /api/password endpoint will reject any request
# that does not supply this secret in the x-internal-secret header.
# Leave empty for local development (all requests allowed locally).
INTERNAL_API_SECRET=""
