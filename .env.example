# ============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO WEBSITE QUẢN LÝ LỚP 11A7
# ============================================================================

# 1. Google Sheets Webhook Authentication Secret Key
# Đặt 1 chuỗi bí mật an toàn (VD: a_very_secure_secret_key_11a7_2026)
# Chuỗi này phải khớp với biến SECRET_KEY trong file scripts/google-sheet-trigger.js
SHEET_WEBHOOK_SECRET=your_secret_key_here

# 2. Vercel Postgres Database Connection Strings (Tùy chọn khi dùng DB)
# Tự động được cấu hình khi kết nối Vercel Postgres DB trên Vercel Dashboard
POSTGRES_URL=postgresql://postgres:password@localhost:5432/web_lop_11a7?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/web_lop_11a7?sslmode=require

# 3. Encryption Secret Key (Optional override for Web Crypto AES-256)
NEXT_PUBLIC_APP_ENV=production
